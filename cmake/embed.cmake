# Embed files as C++ string literals. Invoked as a script:
#   cmake -DOUT=<cpp> -DLIST=<file with one path per line> -DROOT=<dir> -P embed.cmake
file(STRINGS ${LIST} FILES)
set(code "// GENERATED by cmake/embed.cmake. Do not edit.\n#include <string_view>\n#include <utility>\nnamespace docx::assets {\nextern const std::pair<std::string_view, std::string_view> files[];\nextern const unsigned n_files;\n")
set(table "")
set(i 0)
foreach(f ${FILES})
    file(READ ${f} hex HEX)
    string(LENGTH "${hex}" n)
    math(EXPR bytes "${n} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" esc "${hex}")
    # split into chunks to keep lines sane
    string(REGEX REPLACE "((\\\\x[0-9a-f][0-9a-f]){64})" "\\1\"\n\"" esc "${esc}")
    file(RELATIVE_PATH rel ${ROOT} ${f})
    string(APPEND code "static const char d${i}[] = \"${esc}\";\n")
    string(APPEND table "  {\"${rel}\", std::string_view(d${i}, ${bytes})},\n")
    math(EXPR i "${i} + 1")
endforeach()
string(APPEND code "const std::pair<std::string_view, std::string_view> files[] = {\n${table}};\nconst unsigned n_files = ${i};\n}\n")
file(WRITE ${OUT}.tmp "${code}")
file(COPY_FILE ${OUT}.tmp ${OUT} ONLY_IF_DIFFERENT)
